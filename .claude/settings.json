{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tools/make-sample-chat.mjs:*)",
      "Bash(node tools/smoke.cjs:*)",
      "Bash(SHOTS=* node tools/smoke.cjs:*)",
      "Bash(node --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/*.zip)",
      "Read(**/WhatsApp Chat*)",
      "Read(**/_chat.txt)"
    ]
  }
}
